rules_version = '2';

// 💜 Deseos de Bartolita — Reglas de Firestore
// Solo permite leer/escribir a quien tenga una sesión (aunque sea anónima)
// creada por firebase-config.js. Esto evita que cualquier persona que
// encuentre tus llaves públicas de Firebase pueda escribir en tu base
// de datos sin pasar por tu propia web.
service cloud.firestore {
  match /databases/{database}/documents {

    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
